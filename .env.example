# QuantumEV — environment template.
# Copy to `.env` at the repository root:  Copy-Item .env.example .env
# docker compose reads this file automatically.

# ---------- Application ----------
APP_NAME=QuantumEV
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# ---------- Backend server ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- PostgreSQL ----------
POSTGRES_USER=quantumev
POSTGRES_PASSWORD=quantumev
POSTGRES_DB=quantumev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Host-run backend (Postgres published by docker compose to localhost:5432)
DATABASE_URL=postgresql+psycopg2://quantumev:quantumev@localhost:5432/quantumev

# ---------- Authentication (Phase 3) ----------
JWT_SECRET_KEY=dev-only-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------- Simulation engine (Phase 5) ----------
SIM_TICK_SECONDS=5
SIM_EV_COUNT=100
SIM_STATION_COUNT=10
SIM_ZONE_COUNT=3
SIM_RANDOM_SEED=42

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
